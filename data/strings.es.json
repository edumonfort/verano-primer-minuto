{
  "src.TIT": { "text": "Verano en ALERTA: Detecta, decide y actúa", "kind": "pptx", "source": "D1/D2", "status": "validated" },
  "src.Q0": { "text": "¿Qué riesgo de verano os parece más fácil subestimar? el calor, las garrapatas, las picaduras o el exceso de confianza", "kind": "pptx", "source": "D2", "status": "validated" },
  "src.Q0n": { "text": "No hay respuesta correcta ni incorrecta", "kind": "pptx", "source": "D2", "status": "validated" },

  "src.P1": { "text": "Beber agua con frecuencia, aunque no tenga sed.", "kind": "pptx", "source": "D3 G1 · D5 G3", "status": "validated" },
  "src.P2": { "text": "Planificar las tareas y las pausas según las condiciones climáticas.", "kind": "pptx", "source": "D3 G1 · D6 G4", "status": "validated" },
  "src.P3": { "text": "Usar crema solar como medida habitual de protección.", "kind": "pptx", "source": "D4 G2", "status": "validated" },
  "src.P4": { "text": "Consultar las alertas meteorológicas en la app de AEMET antes de trabajos en exterior.", "kind": "pptx", "source": "D4 G2 · D5 G3", "status": "validated" },
  "src.P5": { "text": "Si trabajo en zonas con vegetación, usar ropa de manga larga, pantalón largo y ropa clara.", "kind": "pptx", "source": "D4 G2 · D6 G4", "status": "validated" },
  "src.P6": { "text": "Al terminar la jornada en exterior, revisar bien el cuerpo por si hubiera garrapatas.", "kind": "pptx", "source": "D5 G3", "status": "validated" },

  "src.A1": { "text": "Una persona está muy acalorada, confundida o desorientada.", "kind": "pptx", "source": "D6 G4", "status": "validated" },
  "src.A2": { "text": "Tras una picadura, aparece hinchazón importante, mareo o dificultad para respirar.", "kind": "pptx", "source": "D3 G1 · D6 G4", "status": "validated" },
  "src.A3": { "text": "Al final del trabajo, alguien detecta una posible garrapata adherida.", "kind": "pptx", "source": "D3 G1", "status": "validated" },

  "src.E1": { "text": "Arrancar una garrapata con los dedos o aplicar aceite, alcohol o calor.", "kind": "pptx", "source": "D3 G1 · D5 G3", "status": "validated" },
  "src.E2": { "text": "Hacer movimientos bruscos para espantar una avispa o abeja que se ha posado encima.", "kind": "pptx", "source": "D3 G1 · D6 G4", "status": "validated" },
  "src.E3": { "text": "Seguir con el trabajo igual, aunque haya alerta de calor y condiciones muy exigentes.", "kind": "pptx", "source": "D4 G2 · D6 G4", "status": "validated" },
  "src.E4": { "text": "Esperar a tener sed para empezar a hidratarse.", "kind": "pptx", "source": "D4 G2 · D5 G3", "status": "validated" },
  "src.E5": { "text": "Quitar importancia a una picadura, aunque haya ahogo o malestar general.", "kind": "pptx", "source": "D4 G2 · D5 G3", "status": "validated" },

  "src.S1": { "text": "Hay trabajo en exterior previsto. Llega una alerta meteorológica y las condiciones son exigentes. ¿Seguimos igual o cambiamos algo?", "kind": "pptx", "source": "D7", "status": "validated" },
  "src.S2": { "text": "Una persona en exterior está muy acalorada, desorientada y empeora rápidamente.", "kind": "pptx", "source": "D8", "status": "validated" },
  "src.S3": { "text": "Al terminar el trabajo, alguien nota una posible garrapata adherida.", "kind": "pptx", "source": "D9", "status": "validated" },
  "src.S4": { "text": "Durante una tarea en exterior aparecen avispas/abejas. Una persona recibe una picadura.", "kind": "pptx", "source": "D10", "status": "validated" },

  "src.QA": { "text": "¿Qué haríamos en el primer minuto?", "kind": "pptx", "source": "D7–D10", "status": "validated" },
  "src.QB": { "text": "¿Qué error evitaríamos?", "kind": "pptx", "source": "D7–D10", "status": "validated" },
