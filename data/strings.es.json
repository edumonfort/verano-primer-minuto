  "src.CMPq": { "text": "¿Qué compromiso hemos adquirido hoy?", "kind": "pptx", "source": "D11", "status": "validated" },
  "src.CMP": { "text": "LLEVAR AGUA FRESCA, BEBER CON FRECUENCIA SIN ESPERAR A TENER CALOR", "kind": "pptx", "source": "D11", "status": "validated" },

